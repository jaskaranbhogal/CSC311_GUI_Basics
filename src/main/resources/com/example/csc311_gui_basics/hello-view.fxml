<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox alignment="CENTER"
      spacing="14.0"
      styleClass="page"
      xmlns:fx="http://javafx.com/fxml"
      stylesheets="@style.css"
      fx:controller="com.example.csc311_gui_basics.HelloController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="25.0"/>
    </padding>

    <Label text="Jaskaran Bhogal"
           styleClass="name-label"
           alignment="CENTER"
           textAlignment="CENTER"
           rotate="-20"
           translateY="-22.0"/>

    <ImageView fitWidth="170.0" fitHeight="170.0" preserveRatio="true">
        <image>
            <Image url="@headshot.jpeg"/>
        </image>
    </ImageView>

    <Label fx:id="welcomeText"
           text="Computer Science Student at Farmingdale State College"
           styleClass="bio-label"
           alignment="CENTER"
           textAlignment="CENTER"
           wrapText="true"
           prefWidth="300.0"
           maxWidth="300.0"/>

    <Separator prefWidth="260.0"/>

    <StackPane alignment="CENTER">
        <Circle radius="55.0"
                fill="#16263b"
                stroke="#29b6e9"
                strokeWidth="3.0"/>

        <ImageView fitWidth="90.0" fitHeight="90.0" preserveRatio="true">
            <image>
                <Image url="@farmingdale.jpeg"/>
            </image>
        </ImageView>
    </StackPane>

    <Label text="Degree Progress: 71%"
           styleClass="section-label"
           alignment="CENTER"
           textAlignment="CENTER"/>

    <ProgressBar progress="0.71" prefWidth="220.0"/>

    <HBox alignment="CENTER" spacing="10.0">
        <Button text="Contact Me"
                styleClass="contact-button"/>

        <Button text="View My Work"
                styleClass="work-button"
                onAction="#onViewWorkButtonClick"/>
    </HBox>

</VBox>
